{
  "buildCommand": "pnpm install && pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "functions": {
    "api/ocr-label.js": { "maxDuration": 60 },
    "api/parse-shipping-receipt.js": { "maxDuration": 60 },
    "api/generate-invoice.js": { "maxDuration": 60 },
    "api/send-invoice.js": { "maxDuration": 60 },
    "api/import-orders.js": { "maxDuration": 60 },
    "api/import-sheets.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/inventory",
      "destination": "/api/inventory"
    },
    {
      "source": "/api/trpc/(.*)",
      "destination": "/api/trpc"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/import-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/import-sheets",
      "schedule": "30 * * * *"
    }
  ]
}